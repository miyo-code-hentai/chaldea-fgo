# Comma-separated emails that are ALWAYS admins (they see the Admin panel at /admin).
# Create the account normally on /signup first, then put its email here and restart.
ADMIN_EMAILS=you@example.com

# Where the SQLite database and uploaded images (avatars, banners, servant art) are stored.
# Default: ./data  (back this folder up; it is the whole community database)
# DATA_DIR=./data
# DB_PATH=./data/chaldea.db
